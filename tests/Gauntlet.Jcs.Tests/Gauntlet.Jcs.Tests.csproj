<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Intentional override: the canonicalizer requests System.Text.Json >= 8.0.5; pin the resolved graph to the supported .NET 10 servicing version. NU1510 is suppressed because .NET 10 also supplies this assembly from its shared framework. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="MackySoft.Json.Canonicalization" Version="0.1.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Gauntlet.Core/Gauntlet.Core.csproj" />
  </ItemGroup>
</Project>
